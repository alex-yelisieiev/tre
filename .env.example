# ── CloakBrowser Pro (optional) ───────────────────────────────────────────────
# Uncomment and fill in your license key for the Chromium 151 Pro build.
# Without this, the free Chromium 146 build from GitHub Releases is used.
# CLOAKBROWSER_LICENSE_KEY=cb_your_key_here

# ── Target URLs (comma-separated) ─────────────────────────────────────────────
# TARGET_URLS=https://shop.axs.com/?c=axs&e=6414022407626854,https://shop.axs.com/?c=axs&e=4436620017755968

# ── Proxy ─────────────────────────────────────────────────────────────────────
# PROXY_FILE=/app/proxies.txt
# PROXY_TYPE=http

# ── Action ────────────────────────────────────────────────────────────────────
# ACTION=both   # screenshot | add_to_cart | both

# ── Browser ───────────────────────────────────────────────────────────────────
# HEADLESS=false
# HUMANIZE=true
# GEOIP=true
# PAGE_TIMEOUT=60000

# ── Retry ─────────────────────────────────────────────────────────────────────
# MAX_RETRIES=3
